rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ===============================================================
    // Global Safety Net (Default Deny)
    // ===============================================================
    match /{document=**} {
      allow read, write: if false;
    }

    // ===============================================================
    // Helper Functions
    // ===============================================================
    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        request.auth.token.email_verified == true &&
        (
          request.auth.token.email == 'rafaelmucio@gmail.com' ||
          exists(/databases/$(database)/documents/admins/$(request.auth.uid))
        );
    }

    function isValidFabrica(fabrica) {
      return fabrica is string &&
        fabrica in ['Fabrica1', 'Fabrica2', 'Fabrica4', 'Fabrica5', 'Fabrica6'];
    }

    function isValidRegistration(data) {
      return data.keys().hasAll(['registro', 'email', 'fabrica', 'dataHora', 'createdAt']) &&
        data.keys().hasOnly(['registro', 'email', 'fabrica', 'dataHora', 'createdAt']) &&
        data.registro is string &&
        data.registro.size() >= 1 &&
        data.registro.size() <= 80 &&
        data.email is string &&
        data.email.size() >= 5 &&
        data.email.size() <= 254 &&
        data.email.matches('^[^\\s@]+@[^\\s@]+\\.[^\\s@]{2,}$') &&
        isValidFabrica(data.fabrica) &&
        data.dataHora is string &&
        data.dataHora.size() >= 10 &&
        data.dataHora.size() <= 32 &&
        data.createdAt is timestamp &&
        data.createdAt == request.time;
    }

    function isValidAdminUser(data) {
      return data.keys().hasAll(['email', 'role']) &&
        data.keys().hasOnly(['email', 'role']) &&
        data.email is string &&
        data.email.size() >= 5 &&
        data.email.size() <= 254 &&
        data.role == 'admin';
    }

    // ===============================================================
    // Collection: registrations (PII protected - Write-once public, Admin read/delete)
    // ===============================================================
    match /registrations/{registrationId} {
      // Apenas o organizador verificado pode ler/listar os cadastros (proteção de PII)
      allow get: if isValidId(registrationId) && isAdmin();
      allow list: if isAdmin();

      // Colaboradores enviam o formulário da simulação (somente criação estritamente validada)
      allow create: if isValidId(registrationId) && isValidRegistration(incoming());

      // Registros são imutáveis após criação
      allow update: if false;

      // Apenas o organizador verificado pode limpar registros
      allow delete: if isValidId(registrationId) && isAdmin();
    }

    // ===============================================================
    // Collection: admins (Gerenciada apenas pelo administrador principal)
    // ===============================================================
    match /admins/{adminId} {
      allow get: if isValidId(adminId) && isAdmin();
      allow list: if isAdmin();
      allow create: if isValidId(adminId) && isAdmin() && isValidAdminUser(incoming());
      allow update: if false;
      allow delete: if isValidId(adminId) && isAdmin();
    }
  }
}
